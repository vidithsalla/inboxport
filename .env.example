# Runtime
RELAY_APP_URL=http://localhost:3000
RELAY_DEMO_MODE=false
RELAY_AUTO_MIGRATE=false
RELAY_SUPPORT_EMAIL=support@example.com
RELAY_ALLOWED_EMAILS=owner@example.com,tester@example.com
# Formspree form endpoint or another HTTPS webhook accepting JSON
RELAY_FEEDBACK_ENDPOINT=

# Clerk (provisioned through Vercel Marketplace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Turso (provisioned through Vercel Marketplace)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google Gmail authorization
RELAY_GOOGLE_CLIENT_ID=
RELAY_GOOGLE_CLIENT_SECRET=

# Independent 32-byte base64url keys generated with npm run secrets:generate
RELAY_COOKIE_KEY=
RELAY_VAULT_KEK=
